# JusticIA — Environment Variables
# Copy to .env and fill in your credentials.
# The app runs in demo mode (in-memory + mock LLM) if keys are missing.

# ── LLM & Voice ──────────────────────────────────────────────────────────────
GROQ_API_KEY=                        # console.groq.com — llama-3.3-70b-versatile + whisper-large-v3

# ── Knowledge Graph ──────────────────────────────────────────────────────────
NEO4J_URI=                           # console.neo4j.io → AuraDB Free → bolt+s://...
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Firestore (Google) ───────────────────────────────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=      # Path to firebase-credentials.json from Firebase Console
FIREBASE_PROJECT_ID=                 # Google Cloud project ID

# ── Auth ─────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-justicia-icesi-2026   # Change this in production
LAWYER_EMAIL=abogado@icesi.edu.co
LAWYER_PASSWORD_HASH=                # SHA256 of your password (default: sha256("icesi2026"))

# ── Twilio WhatsApp Sandbox ───────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=                  # twilio.com → Console → Account SID
TWILIO_AUTH_TOKEN=                   # twilio.com → Console → Auth Token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886   # Twilio Sandbox number (default)

# ── SIC Submission — Strategy C (email, for demo) ────────────────────────────
SIC_EMAIL=quejas@sic.gov.co
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=                           # Clinic's Gmail address
SMTP_PASSWORD=                       # Gmail App Password (not account password)

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
HOST=0.0.0.0
